# Datenbank
DATABASE_URL=file:/data/app.db

# Session-Sicherheit (mindestens 32 Zeichen)
# Generieren mit: openssl rand -hex 32
SESSION_SECRET=

# PINs (unbedingt vor der Party ändern!)
BAR_PIN=1234
ADMIN_PIN=9999

# Reverse-Proxy-Deployment
# HOST_PORT: Host-Port, auf dem der Container erreichbar ist (Standard: 3000)
HOST_PORT=3000
# DATA_DIR: Absoluter Pfad zum Daten-Verzeichnis auf dem Host (Standard: ./data)
DATA_DIR=./data
# TRUST_PROXY: Auf "true" setzen, wenn TLS durch einen vorgelagerten Reverse Proxy
# (z. B. Nginx) terminiert wird. Setzt das Secure-Flag auf Session-Cookies.
TRUST_PROXY=false
